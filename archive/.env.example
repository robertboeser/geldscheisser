# Copy to .env and adjust. All settings are prefixed GS_ and can also be set
# as environment variables. Defaults live in common/gs_common/config.py.

# The collector's Postgres, reached over the tailnet — the collector runs a
# Tailscale sidecar (see ../collector/TAILSCALE.md) that serves it at
# gs-collector:5432 to other tailnet peers. This Pi needs to be a tailnet
# peer too; a host-level Tailscale install is enough (the archive only dials
# out). Docker's embedded resolver forwards to the host's MagicDNS server, so
# the `gs-collector` name resolves from inside the containers as well.
# Do NOT point this at a public IP secured by just a password.
GS_SOURCE_DATABASE_URL=postgresql://gs:gs@gs-collector:5432/geldscheisser

# How often to pull new rows. Daily. Nothing here is latency-sensitive, so the
# cadence is really about how much work one run has to do and how fresh the
# archive is for training. The collector's 90-day retention is the safety
# margin: it tolerates ~90 consecutive missed syncs before anything is lost.
GS_ARCHIVE_SYNC_INTERVAL_S=86400

# Rows fetched per page, per table. On a 4GB Pi keep this well below the
# 20000 default: book_snapshots rows carry top-500-levels-per-side JSONB
# (~22KB each, measured), so 20000-row pages mean ~440MB of raw JSON per page
# and multiple GB once parsed. 2000 is a comfortable fit and costs nothing —
# the archive is not time-sensitive.
GS_ARCHIVE_BATCH_SIZE=2000

# Alerts for failed syncs (leave empty to log only).
GS_DISCORD_WEBHOOK_URL=

GS_LOG_LEVEL=INFO

# Local archive DB — only needed when running outside compose
# (inside compose it is set to the timescaledb container automatically).
# The published port is bound to 127.0.0.1 on the Pi; from elsewhere on the
# tailnet use gs-archive:5433 (see README.md).
GS_DATABASE_URL=postgresql://gs:gs@localhost:5433/geldscheisser
