# Copy to .env and adjust. All settings are prefixed GS_ and can also be set
# as environment variables. Defaults live in common/gs_common/config.py.

# Discord webhook for alerts and daily data-quality reports (leave empty to log only).
GS_DISCORD_WEBHOOK_URL=

# Symbol universe (comma-separated, liquid USDT pairs).
GS_SYMBOLS=BTCUSDT,ETHUSDT,BNBUSDT,SOLUSDT,XRPUSDT,ADAUSDT,DOGEUSDT,LINKUSDT,AVAXUSDT,LTCUSDT

# Candle intervals to collect/backfill.
GS_KLINE_INTERVALS=1m,5m,15m,1h

# How far back the kline/funding backfill reaches.
GS_BACKFILL_START=2021-01-01

# Retention: the collector runs on the VPS with a rolling window — it only
# needs enough history for live features. The archive/ module (on the Pi)
# pulls from here on a fixed interval and keeps everything, unbounded.
GS_RETENTION_DAYS=90

# Postgres DSN — only needed when running services OUTSIDE compose
# (inside compose it is set to the timescaledb container automatically).
GS_DATABASE_URL=postgresql://gs:gs@localhost:5433/geldscheisser

# Log level (DEBUG, INFO, WARNING, ...).
GS_LOG_LEVEL=INFO
